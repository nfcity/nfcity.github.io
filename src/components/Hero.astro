---
import HeroScene from './HeroScene.astro';
import Skyline from './Skyline.astro';
import Icon from './Icon.astro';
import { telegramLink } from '../data/site';
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <div
    class="container-x relative z-10 grid gap-7 pt-7 pb-32 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-20 lg:pb-52"
  >
    <div class="lg:col-span-7">
      <p class="label">{t.hero.eyebrow}</p>
      <h1 class="hero-title mt-4 lg:mt-6">{t.hero.title}</h1>
      <p class="lead mt-5 max-w-[33rem] text-cream/78 lg:mt-7">{t.hero.lead}</p>

      <div class="mt-8 hidden flex-wrap items-center gap-x-7 gap-y-4 lg:flex">
        <a href={telegramLink(t.messages.general)} class="btn btn-primary" data-hero-cta>
          <Icon name="send" />
          {t.cta.telegram}
        </a>
        <a
          href="#how"
          class="group inline-flex min-h-11 items-center gap-2 font-semibold text-cream/85 transition-colors duration-200 hover:text-cream"
        >
          {t.hero.secondary}
          <Icon
            name="arrow-down"
            size={18}
            class="transition-transform duration-300 ease-(--ease-soft) group-hover:translate-y-0.5"
          />
        </a>
      </div>

      <ul class="mt-10 hidden gap-x-8 gap-y-2 text-[0.9375rem] text-cream/62 lg:flex">
        {t.hero.notes.map((note) => <li class="hero-note">{note}</li>)}
      </ul>
    </div>

    <div class="lg:col-span-5">
      <HeroScene t={t} />
    </div>

    <ul class="-mt-2 flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm text-cream/62 lg:hidden">
      {t.hero.notes.map((note) => <li class="hero-note">{note}</li>)}
    </ul>
  </div>

  <Skyline class="absolute inset-x-0 bottom-0 z-0 h-[clamp(7rem,17vw,13.75rem)] w-full" />
</section>

<style>
  .hero-title {
    font-size: clamp(1.75rem, 0.95rem + 3.9vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  /* A short cream tick before each note, instead of a bullet. */
  .hero-note {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .hero-note::before {
    content: '';
    width: 0.875rem;
    height: 1.5px;
    background: currentColor;
  }
</style>
