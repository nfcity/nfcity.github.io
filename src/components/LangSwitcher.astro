---
import { locales, localeNames, localePath, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;
---

<nav aria-label={t.a11y.language}>
  <ul class="flex items-center">
    {
      locales.map((l) => (
        <li>
          <a
            href={localePath(l)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            class:list={[
              'grid min-h-11 min-w-11 place-items-center text-[0.8125rem] font-semibold tracking-[0.1em] uppercase transition-colors duration-300 ease-(--ease-soft)',
              l === locale ? 'text-cream' : 'text-cream/60 hover:text-cream',
            ]}
          >
            <span class:list={['pb-0.5', l === locale && 'border-b-2 border-cream']}>
              {l}
              <span class="sr-only"> — {localeNames[l]}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
