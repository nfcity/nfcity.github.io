---
// Drawn card mockups. These stand in for product photos:
// swap each one for a real photo when you have them (see README).
import type { ProductId } from '../data/site';

interface Props {
  kind: ProductId;
  label: string;
  class?: string;
  [key: string]: unknown;
}
const { kind, label, class: className, ...rest } = Astro.props;
const star =
  'M12 2.9l2.72 5.6 6.13.86-4.45 4.3 1.07 6.1L12 16.85 6.53 19.76l1.07-6.1-4.45-4.3 6.13-.86z';
const navy = 'var(--color-navy)';
---

<svg class={className} viewBox="0 0 320 210" role="img" aria-label={label} {...rest}>
  <g transform="rotate(-7 160 105)">
    <rect x="66" y="52" width="196" height="124" rx="13" fill="#01020f" opacity="0.5"></rect>
    <rect x="62" y="43" width="196" height="124" rx="13" fill="var(--color-cream)"></rect>

    <g transform="translate(62 43)">
      {
        kind === 'review' && (
          <g fill={navy}>
            {[0, 1, 2, 3, 4].map((i) => (
              <path d={star} transform={`translate(${16 + i * 25} 38) scale(0.96)`} />
            ))}
          </g>
        )
      }
      {
        kind === 'business' && (
          <g fill={navy}>
            <circle cx="34" cy="50" r="17" />
            <rect x="62" y="38" width="66" height="8" rx="4" />
            <rect x="62" y="54" width="42" height="6" rx="3" opacity="0.4" />
          </g>
        )
      }
      {
        kind === 'social' && (
          <g fill={navy}>
            <text x="14" y="67" font-family="var(--font-display)" font-weight="800" font-size="44">
              @
            </text>
            <rect x="66" y="38" width="68" height="8" rx="4" />
            <rect x="66" y="54" width="44" height="6" rx="3" opacity="0.4" />
          </g>
        )
      }
      {
        kind === 'menu' && (
          <g fill={navy}>
            {[
              [30, 58],
              [46, 42],
              [62, 64],
            ].map(([y, w]) => (
              <>
                <rect x="16" y={y} width={w} height="6" rx="3" />
                <rect x="124" y={y} width="18" height="6" rx="3" opacity="0.4" />
                <path
                  d={`M${24 + w} ${y + 3}H116`}
                  stroke={navy}
                  stroke-width="1.6"
                  stroke-dasharray="0.1 5"
                  stroke-linecap="round"
                  opacity="0.5"
                />
              </>
            ))}
          </g>
        )
      }

      <text
        x="16"
        y="107"
        font-family="var(--font-display)"
        font-weight="800"
        font-size="12.5"
        letter-spacing="-0.2"
        fill={navy}
      >
        NFC
      </text>

      <g
        class="art-arcs"
        transform="translate(152 33) scale(0.86)"
        fill="none"
        stroke="var(--color-red)"
        stroke-width="5.4"
        stroke-linecap="round"
      >
        <path d="M9.46 20.61A12 12 0 0 1 9.46 35.39"></path>
        <path d="M18.12 13.83A23 23 0 0 1 18.12 42.17"></path>
        <path d="M26.79 7.06A34 34 0 0 1 26.79 48.94"></path>
      </g>
    </g>
  </g>
</svg>

<style>
  /* Where the 3D card is not running but there is a mouse, the drawn arcs pulse on hover. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.tile:hover) .art-arcs path {
      transform-box: fill-box;
      transform-origin: 0% 50%;
      animation: arc-pulse 0.85s var(--ease-soft) 2;
    }
    :global(.tile:hover) .art-arcs path:nth-child(2) {
      animation-delay: 0.12s;
    }
    :global(.tile:hover) .art-arcs path:nth-child(3) {
      animation-delay: 0.24s;
    }
  }
  @keyframes arc-pulse {
    45% {
      transform: scale(1.16);
      opacity: 0.65;
    }
  }
</style>
