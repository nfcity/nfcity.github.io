---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import HowItWorks from './HowItWorks.astro';
import Products from './Products.astro';
import Services from './Services.astro';
import Why from './Why.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import StickyCta from './StickyCta.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Base locale={locale} t={t}>
  <Header locale={locale} t={t} />
  <main id="main">
    <Hero t={t} />
    <HowItWorks t={t} />
    <Products locale={locale} t={t} />
    <Services t={t} />
    <Why t={t} />
    <Faq t={t} />
    <Contact locale={locale} t={t} />
  </main>
  <StickyCta t={t} />
</Base>
