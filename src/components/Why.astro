---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section id="why" class="section bg-cream text-navy">
  <div class="container-x">
    <header data-reveal>
      <p class="label">{t.why.label}</p>
      <h2 class="h2 mt-4 max-w-[40rem]">{t.why.title}</h2>
    </header>

    <ul class="mt-11 border-t border-navy/18 lg:mt-16">
      {
        t.why.items.map((item) => (
          <li
            class="grid gap-3 border-b border-navy/18 py-8 lg:grid-cols-12 lg:items-baseline lg:gap-10 lg:py-11"
            data-reveal
          >
            <h3 class="why-title lg:col-span-7">{item.title}</h3>
            <p class="max-w-[30rem] text-navy/78 lg:col-span-5 lg:text-lg">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why-title {
    font-size: clamp(1.375rem, 0.95rem + 2.1vw, 2.5rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }
</style>
