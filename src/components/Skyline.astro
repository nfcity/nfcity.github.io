---
// Quiet city silhouette, drawn once from a fixed seed so it never changes between builds.
interface Props {
  class?: string;
  seed?: number;
  [key: string]: unknown;
}
const { class: className, seed = 7, ...rest } = Astro.props;

const W = 1440;
const H = 220;

function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function layer(s: number, minH: number, maxH: number, minW: number, maxW: number, lit: number) {
  const r = rng(s);
  let x = 0;
  let d = `M0 ${H}`;
  let windows = '';
  while (x < W) {
    const w = Math.round(minW + r() * (maxW - minW));
    const h = Math.round(minH + r() * (maxH - minH));
    const top = H - h;
    const right = Math.min(W, x + w);
    d += `V${top}H${right}`;
    if (r() < lit && w > 34) {
      for (let wy = top + 12; wy < H - 14; wy += 13) {
        for (let wx = x + 8; wx < right - 10; wx += 11) {
          if (r() < 0.34) windows += `M${wx} ${wy}h4v5h-4z`;
        }
      }
    }
    x = right;
  }
  d += `V${H}Z`;
  return { d, windows };
}

const far = layer(seed * 13 + 1, 60, 150, 36, 84, 0);
const near = layer(seed * 29 + 5, 30, 108, 44, 110, 0.55);
// One tall tower with a spire, like the skyline behind the logo.
const tower = 'M828 220V52h10V30h6V4h4v26h6v22h10v168Z';
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <path d={far.d} fill="#080b36"></path>
  <path d={tower} fill="#080b36"></path>
  <path d={near.d} fill="#0c1043"></path>
  <path d={near.windows} fill="#fbeed9" opacity="0.09"></path>
</svg>
