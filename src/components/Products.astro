---
import ProductArt from './ProductArt.astro';
import Icon from './Icon.astro';
import frontReview from '../assets/card/front-review.webp';
import frontBusiness from '../assets/card/front-business.webp';
import frontSocial from '../assets/card/front-social.webp';
import frontMenu from '../assets/card/front-menu.webp';
import cardBack from '../assets/card/back.webp';
import { products, telegramLink, type ProductId } from '../data/site';
import { formatPrice, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;

// Faces of the 3D cards (desktop). Built by scripts/make-card-textures.mjs.
const fronts: Record<ProductId, string> = {
  review: frontReview.src,
  business: frontBusiness.src,
  social: frontSocial.src,
  menu: frontMenu.src,
};
---

<section id="products" class="section bg-cream text-navy">
  <div class="container-x">
    <header class="max-w-[44rem]" data-reveal="children">
      <p class="label">{t.products.label}</p>
      <h2 class="h2 mt-4">{t.products.title}</h2>
      <p class="lead mt-5 text-navy/75">{t.products.lead}</p>
    </header>

    <ul class="mt-11 grid gap-4 md:grid-cols-3 lg:mt-14 lg:gap-5">
      {
        products.map((product, index) => {
          const item = t.products.items[product.id];
          const price =
            product.price === null
              ? t.products.askPrice
              : formatPrice(product.price, locale, t.products.currency);
          return (
            <li class:list={[product.featured && 'md:col-span-3']} data-reveal>
              <div class="tile" data-tile={product.featured ? 'lift' : ''}>
                <article class:list={['product', product.featured && 'product-featured']}>
                  <div
                    class="product-art"
                    style={`--float-delay:${index * -1.7}s`}
                    data-card3d
                    data-front={fronts[product.id]}
                    data-back={cardBack.src}
                    {...(product.featured ? { 'data-turn': '' } : {})}
                  >
                    <ProductArt kind={product.id} label={`${t.products.placeholder}: ${item.name}`} />
                  </div>
                  <div class="product-body">
                    <h3 class="product-name">{item.name}</h3>
                    <p class="product-text">{item.text}</p>
                    <div class="product-foot">
                      {
                        product.available ? (
                          <>
                            <p class="product-price">{price}</p>
                            <a
                              href={telegramLink(t.messages[product.id])}
                              class:list={['btn', product.featured ? 'btn-primary' : 'btn-outline']}
                            >
                              {t.products.order}
                              <span class="sr-only">: {item.name}</span>
                              <Icon name="arrow-right" size={18} />
                            </a>
                          </>
                        ) : (
                          <p class="product-soon">{t.products.soon}</p>
                        )
                      }
                    </div>
                  </div>
                </article>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Wrapper that carries the hover shadow of the large tile, so the tile can lift above it.
     The shadow is always painted and only its opacity changes. */
  .tile {
    position: relative;
    height: 100%;
    isolation: isolate;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0.75rem 1rem -0.25rem;
    z-index: -1;
    border-radius: 1.375rem;
    box-shadow: 0 1.75rem 2.75rem -0.75rem color-mix(in srgb, var(--color-navy) 55%, transparent);
    opacity: 0;
    transition: opacity 0.6s var(--ease-soft);
    pointer-events: none;
  }
  /* .is-hover is set by src/scripts/motion.ts together with the lift, so the two never drift apart. */
  .tile:global(.is-hover)::after {
    opacity: 1;
  }

  .product {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 1.375rem;
    background: var(--color-navy);
    color: var(--color-cream);
  }
  .product-art {
    position: relative;
    background: var(--color-navy-2);
  }
  .product-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.6s var(--ease-soft);
  }

  /* The drawn card floats gently; each tile starts at a different point in the cycle. */
  @media (prefers-reduced-motion: no-preference) {
    .product-art :global(svg) {
      animation: art-float 7s ease-in-out var(--float-delay, 0s) infinite;
    }
    .product-art:global(.is-3d) :global(svg) {
      animation-play-state: paused;
    }
  }
  @keyframes art-float {
    50% {
      transform: translateY(-2.2%) rotate(0.6deg);
    }
  }

  /* The 3D card (desktop only) is drawn over the same box as the drawn mockup,
     which stays underneath as the fallback and for screen readers. */
  .product-art :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s var(--ease-soft);
  }
  .product-art:global(.is-3d) :global(canvas) {
    opacity: 1;
  }
  .product-art:global(.is-3d) :global(svg) {
    opacity: 0;
  }

  .product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem 1.375rem 1.375rem;
  }
  .product-name {
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .product-text {
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--color-cream) 76%, transparent);
  }
  .product-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.75rem;
  }
  .product-price {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  /* "Available soon": the site's outline-button shape at badge size, in the brand red. */
  .product-soon {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.875rem;
    border: 1.5px solid var(--color-red);
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (min-width: 48rem) {
    .product-featured {
      flex-direction: row;
      align-items: stretch;
    }
    .product-featured .product-art {
      display: grid;
      flex: 0 0 52%;
      place-items: center;
    }
    .product-featured .product-body {
      justify-content: center;
      padding: 2.5rem;
    }
    .product-featured .product-name {
      font-size: clamp(1.5rem, 1rem + 1.6vw, 2.125rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
    }
    .product-featured .product-text {
      max-width: 28rem;
      margin-top: 1rem;
      font-size: 1.125rem;
    }
    .product-featured .product-foot {
      justify-content: flex-start;
      gap: 1.75rem;
      margin-top: 0;
      padding-top: 2.25rem;
    }
  }
</style>
