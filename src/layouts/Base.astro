---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../data/site';
import { locales, localePath, ogLocales, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
  title?: string;
  noindex?: boolean;
}

const { locale, t, title = t.meta.title, noindex = false } = Astro.props;

const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(localePath(locale));
const ogImage = abs('/og.png');

// Preload only the alphabet this page is written in.
const preload =
  locale === 'ru'
    ? [{ subset: 'cyrillic' }, { subset: 'latin' }]
    : [{ subset: 'latin' }];

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: t.meta.description,
  url: canonical,
  logo: abs('/logo.png'),
  image: ogImage,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tashkent',
    addressCountry: 'UZ',
  },
  areaServed: { '@type': 'Country', name: 'Uzbekistan' },
  sameAs: [site.telegram, site.instagram],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phone,
    contactType: 'sales',
    availableLanguage: ['uz', 'ru', 'en'],
  },
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#04072d" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-unbounded" preload={preload} />
    <Font cssVariable="--font-onest" preload={preload} />

    <!-- Turns animation on only when the visitor has not asked for reduced motion.
         If the main script never arrives, content is shown anyway after 3 seconds. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        // Desktops with a mouse get the Three.js hero. Marking them now lets that scene
        // fade in on its own, instead of swapping with the CSS one in front of the visitor.
        if (
          window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 64rem)').matches &&
          (navigator.hardwareConcurrency || 4) >= 4
        ) {
          root.classList.add('gl-first');
        }
        setTimeout(function () {
          if (!window.__nfcityMotion) root.classList.remove('motion', 'gl-first');
        }, 3000);
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faq)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-50 rounded-lg bg-cream px-4 py-3 font-semibold text-navy"
    >
      {t.a11y.skip}
    </a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
